{
  "name": "@abbaing/code-map",
  "version": "0.1.0",
  "description": "Architectural graph generator and interactive viewer for your codebase.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abbaing/code-map.git"
  },
  "bugs": {
    "url": "https://github.com/abbaing/code-map/issues"
  },
  "homepage": "https://github.com/abbaing/code-map#readme",
  "bin": {
    "code-map": "./cli.mjs"
  },
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./submap": {
      "types": "./submap/index.d.ts",
      "import": "./submap/index.mjs"
    },
    "./schemas/graph": "./schemas/graph.schema.json",
    "./schemas/submap": "./schemas/submap.schema.json",
    "./schemas/submap-request": "./schemas/submap-request.schema.json",
    "./*": "./*"
  },
  "scripts": {
    "build:viewer-css": "tailwindcss -i ./viewer/tailwind.input.css -o ./viewer/tailwind.css --minify",
    "check": "npm run lint && npm run format:check && npm test",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "prepublishOnly": "npm run release:check",
    "release:check": "npm run lint && npm run format:check && npm run test:coverage && npm run build:viewer-css && git diff --exit-code -- viewer/tailwind.css && npm run pack:dry",
    "test": "node tests/architecture.test.mjs && node tests/component-contracts.test.mjs && node tests/platform.test.mjs && node tests/scan-pipeline.test.mjs && node tests/backend-analysis-session.test.mjs && node tests/source-analysis.test.mjs && node tests/findings.test.mjs && node tests/template-contracts.test.mjs && node tests/core-critical.test.mjs && node tests/generic-templates.test.mjs && node tests/server-app.test.mjs && node tests/cli-smoke.test.mjs && node tests/submap.test.mjs && node tests/submap-strategies.test.mjs && node tests/submap-cli.test.mjs && node tests/viewer-trace.test.mjs && node tests/viewer-render.test.mjs",
    "test:coverage": "c8 --all --include=*.mjs --include=rules/**/*.mjs --include=submap/**/*.mjs --include=templates/**/*.mjs --check-coverage --lines=78 --statements=78 --branches=77 --functions=80 npm test",
    "pack:dry": "npm pack --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/cli": "4.3.3",
    "c8": "11.0.0",
    "eslint": "9.39.5",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3"
  },
  "files": [
    "cli.mjs",
    "index.mjs",
    "index.d.ts",
    "config.mjs",
    "classify.mjs",
    "backend-analysis-session.mjs",
    "detect.mjs",
    "endpoints.mjs",
    "graph.mjs",
    "json-io.mjs",
    "quality.mjs",
    "resolve.mjs",
    "scan.mjs",
    "scan-pipeline.mjs",
    "scan-back.mjs",
    "scan-front.mjs",
    "scan-utils.mjs",
    "source-analysis.mjs",
    "server.mjs",
    "server-app.mjs",
    "architecture/",
    "platform/",
    "submap/",
    "LICENSE",
    "COMMERCIAL.md",
    "ARCHITECTURE.md",
    "COMPONENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "RELEASING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "TRADEMARK.md",
    "rules/",
    "templates/",
    "tests/",
    "viewer/",
    "schemas/",
    "presets/"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "architecture",
    "code-map",
    "dependency-graph",
    "codebase-visualization",
    "static-analysis",
    "developer-tools"
  ],
  "license": "AGPL-3.0-only"
}
