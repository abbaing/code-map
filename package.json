{
  "name": "@abbaing/code-map",
  "version": "0.1.0",
  "description": "Architectural graph generator and interactive viewer for your codebase.",
  "type": "module",
  "imports": {
    "#app/*": "./src/application/*",
    "#architecture/*": "./architecture/*",
    "#core/*": "./src/core/*",
    "#delivery/*": "./src/delivery/*",
    "#entry/*": "./*",
    "#node/*": "./src/adapters/node/*",
    "#parsers/*": "./src/adapters/parsers/*",
    "#platform/*": "./platform/*",
    "#rules/*": "./rules/*",
    "#scanners/*": "./src/scanners/*",
    "#submap/*": "./submap/*",
    "#templates/*": "./templates/*",
    "#tests/*": "./tests/*",
    "#viewer/*": "./viewer/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abbaing/code-map.git"
  },
  "bugs": {
    "url": "https://github.com/abbaing/code-map/issues"
  },
  "homepage": "https://github.com/abbaing/code-map#readme",
  "bin": {
    "code-map": "./cli.mjs"
  },
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./submap": {
      "types": "./submap/index.d.ts",
      "import": "./submap/index.mjs"
    },
    "./schemas/graph": "./schemas/graph.schema.json",
    "./schemas/project-map": "./schemas/project-map.schema.json",
    "./schemas/submap": "./schemas/submap.schema.json",
    "./schemas/submap-request": "./schemas/submap-request.schema.json"
  },
  "scripts": {
    "audit:dependencies": "npm audit --audit-level=high && npm audit signatures",
    "build:viewer-css": "tailwindcss -i ./viewer/tailwind.input.css -o ./viewer/tailwind.css --minify",
    "check": "npm run lint && npm run format:check && npm test",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --suppressions-location eslint-suppressions.json",
    "prepublishOnly": "npm run release:check",
    "release:check": "npm run lint && npm run format:check && npm run test:coverage && npm run build:viewer-css && git diff --exit-code -- viewer/tailwind.css && npm run pack:dry",
    "test": "node tests/run-tests.mjs",
    "test:coverage": "c8 npm test && node tests/coverage-policy.mjs",
    "pack:dry": "npm pack --dry-run --json | node tests/package-contents.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/cli": "4.3.3",
    "c8": "11.0.0",
    "eslint": "9.39.5",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3"
  },
  "files": [
    "cli.mjs",
    "index.mjs",
    "index.d.ts",
    "server.mjs",
    "src/",
    "platform/",
    "submap/",
    "LICENSE",
    "COMMERCIAL.md",
    "ANALYSIS.md",
    "ARCHITECTURE.md",
    "COMPONENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "RELEASING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "TRADEMARK.md",
    "rules/",
    "templates/",
    "viewer/",
    "schemas/",
    "presets/"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "architecture",
    "code-map",
    "dependency-graph",
    "codebase-visualization",
    "static-analysis",
    "developer-tools"
  ],
  "license": "AGPL-3.0-only",
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "tree-sitter": "0.25.1",
    "tree-sitter-c-sharp": "0.23.5",
    "typescript": "5.9.3"
  }
}
