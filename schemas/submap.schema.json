{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abbaing/code-map/schemas/submap.schema.json",
  "title": "Code Map Submap",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "id",
    "uid",
    "revision",
    "parentUid",
    "createdAt",
    "source",
    "selection",
    "access",
    "nodes",
    "edges",
    "findings",
    "orphanNodeIds",
    "boundaries",
    "catalog",
    "statistics",
    "warnings",
    "metadata"
  ],
  "properties": {
    "kind": { "const": "code-map/submap" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "uid": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "parentUid": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["graphVersion", "graphDigest", "projectName"],
      "properties": {
        "graphVersion": { "type": "integer" },
        "graphDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "graphGeneratedAt": { "type": "string" },
        "projectName": { "type": "string" },
        "git": { "type": "object" }
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": ["seeds", "resolvedSeedNodeIds", "traversal", "exclusions"],
      "properties": {
        "seeds": { "$ref": "submap-request.schema.json#/$defs/selector" },
        "resolvedSeedNodeIds": { "$ref": "#/$defs/stringArray" },
        "traversal": { "type": "object" },
        "exclusions": { "$ref": "submap-request.schema.json#/$defs/selector" }
      },
      "additionalProperties": false
    },
    "access": {
      "type": "object",
      "required": ["default", "editable", "readable", "external", "forbidden", "generated"],
      "properties": {
        "default": { "enum": ["editable", "readable", "external", "forbidden", "generated"] },
        "editable": { "$ref": "#/$defs/stringArray" },
        "readable": { "$ref": "#/$defs/stringArray" },
        "external": { "$ref": "#/$defs/stringArray" },
        "forbidden": { "$ref": "#/$defs/stringArray" },
        "generated": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "nodes": { "type": "array", "items": { "$ref": "graph.schema.json#/properties/nodes/items" } },
    "edges": { "type": "array", "items": { "$ref": "graph.schema.json#/properties/edges/items" } },
    "findings": { "type": "array", "items": { "$ref": "graph.schema.json#/properties/findings/items" } },
    "orphanNodeIds": { "$ref": "#/$defs/stringArray" },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["edgeId", "insideNodeId", "direction", "outsideNode", "reason"],
        "properties": {
          "edgeId": { "type": "string" },
          "insideNodeId": { "type": "string" },
          "direction": { "enum": ["incoming", "outgoing"] },
          "outsideNode": { "type": "object", "required": ["id", "label", "type", "layer", "module"] },
          "reason": { "enum": ["excluded", "depth-limit"] }
        },
        "additionalProperties": false
      }
    },
    "catalog": { "type": "object" },
    "statistics": { "type": "object" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "stringArray": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "additionalProperties": false
}
